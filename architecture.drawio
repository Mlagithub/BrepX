        <mxCell id="node_smlib_kernel" parent="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fbc02d;fontFamily=Arial;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;SMLib NURBS C++ Kernel (smlibpy 0.4.0)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#39;#f57f17&#39;&gt;• &lt;b&gt;B-Rep 真实拓扑结构&lt;/b&gt;: Part, Shell, Face, Wire, Edge, Vertex, Sketch&lt;br/&gt;• &lt;b&gt;高精度几何算法&lt;/b&gt;: NURBS 曲面构建、连续性倒圆角、修剪曲面布尔运算&lt;br/&gt;• &lt;b&gt;工业内核三角化引擎&lt;/b&gt;: C++ 级边界网格划分与离散曲率控制&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="570" x="20" y="35" as="geometry" />
        </mxCell>
        <mxCell id="node_engineering_delivery" parent="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fbc02d;fontFamily=Arial;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;工业标准与 CFD 仿真全栈交付&lt;/b&gt;&lt;br/&gt;&lt;font color=&#39;#f57f17&#39;&gt;• &lt;b&gt;STEP AP242 标准文件&lt;/b&gt;: 携带面级装配与物理边界属性 (Inlet/Outlet/Wall)&lt;br/&gt;• &lt;b&gt;OpenFOAM 仿真边界字典&lt;/b&gt;: 导出零网格歧义的边界条件配置&lt;br/&gt;• &lt;b&gt;工程三维资产&lt;/b&gt;: 高精度 STL 流体域表面网格、glTF 实时预览模型&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="600" x="610" y="35" as="geometry" />
        </mxCell>
