        <mxCell id="node_gw_agent" parent="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#455a64;fontFamily=Arial;fontSize=10;align=center;" value="&lt;b&gt;具身 Agent 交互路由&lt;/b&gt;&lt;br/&gt;&lt;font color=&#39;#37474f&#39;&gt;/api/agent/chat&lt;br/&gt;• 选区与历史上下文注入&lt;br/&gt;• 自动化纠错重试机制&lt;/font&gt;" vertex="1">
          <mxGeometry height="55" width="270" x="320" y="35" as="geometry" />
        </mxCell>
        <mxCell id="node_gw_semantic" parent="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#455a64;fontFamily=Arial;fontSize=10;align=center;" value="&lt;b&gt;CFD 物理语义路由&lt;/b&gt;&lt;br/&gt;&lt;font color=&#39;#37474f&#39;&gt;/api/semantic/patches&lt;br/&gt;/api/semantic/assign&lt;br/&gt;/api/semantic/remove&lt;/font&gt;" vertex="1">
