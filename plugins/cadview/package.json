{
  "name": "cadview",
  "version": "0.0.1",
  "private": true,
  "description": "CAD viewport and tool cards for the BrepX workbench, mounted in the dsh web client.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "dependencies": {
    "@classcad/smlibpy-three": "^0.6.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "esbuild src/viewport.js --bundle --format=esm --platform=browser --target=es2022 --log-level=warning --outfile=lib/viewport.mjs"
  }
}
